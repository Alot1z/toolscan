{
  "name": "toolscan",
  "version": "2.1.0",
  "description": "Cross-platform tool discovery beyond PATH: XDG + common install roots, bounded and truthful with fail-closed JSON output. For agent harnesses, skill installers, MCP servers, and CI drift checks.",
  "type": "module",
  "bin": {
    "toolscan": "dist/toolscan.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "discovery",
    "scanner",
    "path",
    "xdg",
    "cli",
    "tooling",
    "ai",
    "agents",
    "mcp",
    "devops",
    "ci",
    "cross-platform"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "^3.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}